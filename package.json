{
  "name": "@apron-design/vue-next",
  "version": "21.0.1",
  "description": "Apron Design - A modern, intelligent Vue 3 component library built with TypeScript and Less. Featuring 40+ components with dark mode support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vue-tsc --noEmit && vite build -c vite.lib.config.ts",
    "docs:dev": "yarn run register:components && vitepress dev docs",
    "docs:build": "yarn run register:components && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,less}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build:lib",
    "register:components": "vitepress-rc"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "less": "^4.2.1",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.6",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10",
    "vitepress-theme-demoblock": "^3.1.3"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "components",
    "ui",
    "ui-components",
    "design-system",
    "component-library",
    "less",
    "typescript",
    "dark-mode"
  ],
  "author": "Apron Design Team, Offontime Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apron-design/vue-next.git"
  },
  "homepage": "https://github.com/apron-design/vue-next#readme",
  "bugs": {
    "url": "https://github.com/apron-design/vue-next/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitepress-demo-preview/component": "^2.6.1",
    "@vitepress-demo-preview/plugin": "^1.4.1"
  }
}
