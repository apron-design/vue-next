import { App } from 'vue';

interface I18nTexts {
    copySuccessText: string;
    copyCode: string;
    foldCode: string;
    expandCode: string;
    hideSourceCode: string;
    [key: string]: string;
}
interface LanguageConfig {
    [lang: string]: I18nTexts;
}
interface ClientComponentConfig {
    copySuccessText?: string;
    vueApp?: App<any>;
    i18n?: LanguageConfig;
    defaultLanguage?: string;
}
/**
 * 获取当前语言
 * @param defaultLang 默认语言
 * @returns 当前语言代码
 */
declare function getCurrentLanguage(defaultLang?: string): string;
/**
 * 获取国际化文本
 * @param key 文本键
 * @param language 语言代码
 * @param config 配置对象
 * @returns 对应的文本
 */
declare function getI18nText(key: string, language: string, config: ClientComponentConfig): string;
/**
 * 定义配置辅助函数
 * @param config 用户配置
 * @returns 合并后的配置
 */
declare function defineClientComponentConfig(config: Partial<ClientComponentConfig>): ClientComponentConfig;

export { type ClientComponentConfig, type I18nTexts, type LanguageConfig, defineClientComponentConfig, getCurrentLanguage, getI18nText };
